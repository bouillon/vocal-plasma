#!/bin/bash

set -e

setup_kde_shortcut_for_user() {
    local user_home="$1"
    local config_file="$user_home/.config/kglobalshortcutsrc"

    [ -d "$user_home" ] || return 0
    [ "$user_home" = "/root" ] && return 0
    [ -f "$config_file" ] || return 0
    grep -qF "[services][net.local.sh.desktop]" "$config_file" && return 0

    cp "$config_file" "$config_file.bak"
    cat >> "$config_file" <<EOF

[services][net.local.sh.desktop]
_launch=Alt+Esc
EOF
    echo "Alt+Esc shortcut added for $user_home"
}

case "$1" in
    configure)
        /usr/bin/kokoro-venv-setup || echo "WARNING: venv setup failed, rerun: kokoro-venv-setup" >&2

        # legacy self-symlink from <= 0.1.1
        [ -L /usr/share/kokoro-tts/models ] && rm -f /usr/share/kokoro-tts/models

        for user_home in /home/*; do
            setup_kde_shortcut_for_user "$user_home" || true
        done

        echo ""
        echo "Test:    echo 'Hello world' | speak"
        echo "Hotkey:  select text, press Alt+Esc (re-login if it does not fire)"
        echo "Voices:  af_sky (default), af_bella, af_nicole, af_sarah, am_michael,"
        echo "         am_adam, bf_emma, bf_isabella, bm_george, bm_lewis"
        ;;

    triggered)
        # /usr/bin/python3 changed
        /usr/bin/kokoro-venv-setup || echo "WARNING: venv setup failed, rerun: kokoro-venv-setup" >&2
        ;;
esac

#DEBHELPER#

exit 0
