#!/bin/bash

set -e

case "$1" in
    purge)
        rm -rf /opt/kokoro-tts

        # drop shortcut section, keep the next section header
        for config_file in /root/.config/kglobalshortcutsrc /home/*/.config/kglobalshortcutsrc; do
            [ -f "$config_file" ] || continue
            sed -i '/^\[services\]\[net\.local\.sh\.desktop\]/,/^\[/{/^\[services\]\[net\.local\.sh\.desktop\]/d;/^\[/!d}' "$config_file" 2>/dev/null || true
        done
        ;;
esac

#DEBHELPER#

exit 0
